<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required by Electron's hardened-runtime processes (V8 JIT, Node's JS engine). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Chat, model downloads, MCP/plugin network calls. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Local MCP servers / plugin hosts that bind a loopback port. -->
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- Voice call feature (src/renderer/call) uses getUserMedia for the mic. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
